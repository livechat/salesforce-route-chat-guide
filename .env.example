# Text API base URLs (production).
TEXT_CONFIGURATION_URL=https://api.livechatinc.com/v3.6/configuration
TEXT_AGENT_URL=https://api.livechatinc.com/v3.6/agent
TEXT_CDP_URL=https://api.text.com/cdp

# Text Settings → API access → Personal access tokens.
# Required scopes: customers:rw and chats--all:rw, plus groups--all:rw
# when Regular or Enterprise must be created (groups--all:ro if both exist).
# Copy the Base64-encoded account_id:personal_access_token value.
TEXT_BASIC_AUTH=

# Text generates this secret when you create the incoming_chat webhook.
# Point that webhook to https://<public-host>/webhooks/text and copy its secret here.
TEXT_WEBHOOK_SECRET=

# Human agents for the two routing groups (comma-separated IDs/emails).
# Each list is required if its group does not exist yet.
TEXT_REGULAR_AGENT_IDS=
TEXT_ENTERPRISE_AGENT_IDS=
TEXT_REGULAR_GROUP_NAME=Regular
TEXT_ENTERPRISE_GROUP_NAME=Enterprise

# Your org-specific Salesforce My Domain URL (Setup → My Domain).
# Production: https://your-company.my.salesforce.com
# Sandbox: https://your-company--sandbox.sandbox.my.salesforce.com
# Client credentials do not work with login.salesforce.com or test.salesforce.com.
SALESFORCE_LOGIN_URL=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_PLAN_FIELD=Plan_Tier__c
SALESFORCE_API_VERSION=61.0

PORT=8080
